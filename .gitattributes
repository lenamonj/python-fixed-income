# Keep every text file with LF line endings on every machine.
# Without this, Git for Windows rewrites line endings on clone, which changes
# the text inside data files and the numbers the notebooks print.
* text=auto eol=lf

*.png  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.ipynb text eol=lf
*.csv   text eol=lf

# The UCI Taiwan file is committed byte for byte as the zip holds it, CRLF line endings included, so its SHA-256
# proves it is the UCI file (DATA.md). Git must not convert it.
data/taiwan_bankruptcy.csv -text

