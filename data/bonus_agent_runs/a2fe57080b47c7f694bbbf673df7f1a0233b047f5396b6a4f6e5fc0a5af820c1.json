    "arguments": "{\"path\":\"bond_math.py\",\"old_str\":\"\",\"new_str\":\"def bond_price(face, coupon_rate, ytm, years, freq=1):\\n    \\\"\\\"\\\"Return the present value of fixed coupons and principal at maturity.\\\"\\\"\\\"\\n    if freq <= 0 or freq != int(freq):\\n        raise ValueError(\\\"freq must be a positive integer\\\")\\n    periods = years * freq\\n    if periods < 0 or periods != int(periods):\\n        raise ValueError(\\\"years * freq must be a nonnegative integer\\\")\\n    periods = int(periods)\\n    coupon = face * coupon_rate / freq\\n    discount = 1 + ytm / freq\\n    return sum(coupon / discount ** t for t in range(1, periods + 1)) + face / discount ** periods\\n\"}",
