    "arguments": "{\"path\":\"bond_math.py\",\"old_str\":\"\",\"new_str\":\"def bond_price(face, coupon_rate, ytm, years, freq=1):\\n    \\\"\\\"\\\"Return the present value of coupons and principal on a regular schedule.\\\"\\\"\\\"\\n    if freq <= 0 or int(freq) != freq:\\n        raise ValueError(\\\"freq must be a positive integer\\\")\\n    periods = years * freq\\n    if periods < 0 or int(periods) != periods:\\n        raise ValueError(\\\"years * freq must be a nonnegative integer\\\")\\n    periods = int(periods)\\n    coupon = face * coupon_rate / freq\\n    discount = 1 + ytm / freq\\n    if discount <= 0:\\n        raise ValueError(\\\"ytm must be greater than -freq\\\")\\n    return sum(coupon / discount ** n for n in range(1, periods + 1)) + face / discount ** periods\\n\"}",
